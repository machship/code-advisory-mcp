# Embedding Backend (azure or ollama)
EMBEDDING_BACKEND=ollama

# Azure OpenAI Configuration (required for azure backend)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-api-key-here

# Ollama Configuration (required for ollama backend)
OLLAMA_BASE_URL=http://localhost:11434/api

# Embedding Model
# For Azure: text-embedding-3-small, text-embedding-3-large
# For Ollama: nomic-embed-text, mxbai-embed-large, etc.
EMBEDDING_MODEL=nomic-embed-text

# Database Configuration
MANIFEST_FILE=manifest.json
OUTPUT_FILE=advisory.db
